{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "trailingComma": "all",
  "tabWidth": 2,
  "semi": true,
  "singleQuote": true,
  "bracketSpacing": true,
  "printWidth": 80,
  "sortPackageJson": false,
  "ignorePatterns": [
    "*.html",
    "*.md",
    "*.json",
    "*.yml",
    "pnpm-lock.yaml",
    ".rollup.cache",
    "out",
    "dist",
    "packages/semantic/src/builders.ts",
    "packages/semantic/src/types.ts"
  ]
}
