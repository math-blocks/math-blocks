{
  "name": "math-blocks",
  "version": "0.0.1",
  "main": "index.js",
  "author": "Kevin Barabash",
  "license": "MIT",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "devDependencies": {
    "@changesets/cli": "^2.27.11",
    "@microlink/react-json-view": "^1.31.51",
    "@playwright/test": "1.63.0",
    "@swc-node/register": "^1.10.9",
    "@swc/core": "^1.9.3",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@tsdown/css": "0.23.7",
    "@types/diff": "^6.0.0",
    "@types/node": "^24.19.2",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^3.2.4",
    "diff": "^7.0.0",
    "jsdom": "^26.1.0",
    "oxfmt": "0.79.0",
    "oxlint": "1.94.0",
    "oxlint-tsgolint": "7.0.2008",
    "tsdown": "0.23.7",
    "type-coverage": "^2.31.2",
    "typedoc": "^0.28.20",
    "typedoc-plugin-missing-exports": "^4.1.4",
    "typescript": "^7.0.2",
    "utility-types": "^3.10.0",
    "vite": "^5.4.0",
    "vitest": "^3.2.4",
    "xml-formatter": "^2.4.0"
  },
  "scripts": {
    "prepublishOnly": "pnpm build",
    "build": "tsdown",
    "check-dist-types": "node scripts/check-dist-types/check.mjs",
    "build-demo": "vite build",
    "build-demo-ci": "vite build --base=/math-blocks/",
    "typecheck": "tsc -b -v --emitDeclarationOnly tsconfig.json",
    "type-coverage": "type-coverage",
    "start": "vite",
    "test": "vitest run",
    "test:debug": "vitest run --inspect-brk --no-file-parallelism",
    "coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "lint": "oxlint --type-aware --report-unused-disable-directives",
    "clean": "rm -rf packages/*/out .buildcache",
    "format": "oxfmt",
    "format:check": "oxfmt --check"
  },
  "dependencies": {
    "classnames": "^2.3.1",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "react-router-dom": "6.28.0"
  },
  "typeCoverage": {
    "atLeast": 95,
    "detail": true,
    "ignoreCatch": true,
    "project": "tsconfig-coverage.json",
    "strict": true
  }
}
