{
  "name": "math-blocks",
  "version": "0.0.1",
  "main": "index.js",
  "author": "Kevin Barabash",
  "license": "MIT",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "devDependencies": {
    "@changesets/cli": "^2.27.11",
    "@codechecks/client": "^0.1.10",
    "@hot-loader/react-dom": "^16.11.0",
    "@microlink/react-json-view": "^1.31.51",
    "@playwright/test": "1.63.0",
    "@swc-node/register": "^1.10.9",
    "@swc/core": "^1.9.3",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@tsdown/css": "0.23.7",
    "@types/diff": "^6.0.0",
    "@types/node": "^24.19.2",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitejs/plugin-react-refresh": "^1.3.6",
    "@vitest/coverage-v8": "^3.2.4",
    "babel-loader": "^8.0.6",
    "core-js": "^3.5.0",
    "css-loader": "^5.2.1",
    "diff": "^7.0.0",
    "file-loader": "^6.2.0",
    "husky": "^3.0.5",
    "jsdom": "^26.1.0",
    "json-schema-to-typescript": "^9.1.1",
    "lint-staged": "^10.2.11",
    "mini-css-extract-plugin": "^1.3.8",
    "oxfmt": "0.79.0",
    "oxlint": "1.94.0",
    "oxlint-tsgolint": "7.0.2008",
    "postcss": "^8.3.9",
    "react-hot-loader": "^4.12.18",
    "react-is": "^17.0.1",
    "sloc": "^0.2.1",
    "ts-loader": "^6.2.1",
    "tsdown": "0.23.7",
    "type-coverage": "^2.31.2",
    "typedoc": "^0.28.20",
    "typedoc-plugin-missing-exports": "^4.1.4",
    "typescript": "^7.0.2",
    "utility-types": "^3.10.0",
    "vite": "^5.4.0",
    "vitest": "^3.2.4",
    "xml-formatter": "^2.4.0",
    "xml2js": "^0.4.23"
  },
  "scripts": {
    "prepublishOnly": "pnpm build",
    "codechecks": "codechecks",
    "build": "tsdown",
    "check-dist-types": "node scripts/check-dist-types/check.mjs",
    "build-demo": "vite build",
    "build-demo-ci": "vite build --base=/math-blocks/",
    "typecheck": "tsc -b -v --emitDeclarationOnly tsconfig.json",
    "type-coverage": "type-coverage",
    "start": "vite",
    "test": "vitest run",
    "test:debug": "vitest run --inspect-brk --no-file-parallelism",
    "coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "lint": "oxlint --type-aware --report-unused-disable-directives",
    "clean": "rm -rf packages/*/out .buildcache",
    "sloc": "sloc packages demo tools -e '(out|dist)'",
    "format": "oxfmt",
    "format:check": "oxfmt --check"
  },
  "dependencies": {
    "classnames": "^2.3.1",
    "fraction.js": "^4.0.12",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "react-router-dom": "6.28.0"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "oxlint --type-aware --report-unused-disable-directives --no-error-on-unmatched-pattern",
      "oxfmt --no-error-on-unmatched-pattern"
    ],
    "*.{js,jsx,cjs,mjs,mts,cts,css,yaml,yml,json,md,html}": "oxfmt --no-error-on-unmatched-pattern"
  },
  "typeCoverage": {
    "atLeast": 95,
    "detail": true,
    "ignoreCatch": true,
    "project": "tsconfig-coverage.json",
    "strict": true
  }
}
