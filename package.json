    "xml-formatter": "^2.4.0",
    "xml2js": "^0.4.23"
  },
  "scripts": {
    "prepublishOnly": "pnpm build",
    "codechecks": "codechecks",
    "build": "tsdown",
    "check-dist-types": "node scripts/check-dist-types/check.mjs",
    "build-demo": "vite build",
    "build-demo-ci": "vite build --base=/math-blocks/",
    "typecheck": "tsc -b -v --emitDeclarationOnly tsconfig.json",
    "type-coverage": "type-coverage",
    "start": "vite",
    "test": "vitest run",
    "test:debug": "vitest run --inspect-brk --no-file-parallelism",
    "coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "lint": "eslint 'packages/**/*.{ts,tsx}' 'demo/src/*.{ts,tsx}' 'e2e/**/*.ts' playwright.config.ts",
    "clean": "rm -rf packages/*/out .buildcache",
    "sloc": "sloc packages demo tools -e '(out|dist)'",
    "format": "prettier . --write"
  },
  "dependencies": {
    "classnames": "^2.3.1",
    "fraction.js": "^4.0.12",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "react-router-dom": "6.28.0"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --config .eslintrc.cjs",
      "pretty-quick"
    ]
  },
  "typeCoverage": {
    "atLeast": 95,
    "detail": true,
    "ignoreCatch": true,
    "project": "tsconfig-coverage.json",
    "strict": true
  }
}
