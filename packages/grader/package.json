{
    "name": "@math-blocks/grader",
    "version": "0.3.0",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/math-blocks/math-blocks.git",
        "directory": "packages/grader"
    },
    "bugs": "https://github.com/math-blocks/math-blocks/issues",
    "homepage": "https://github.com/math-blocks/math-blocks/tree/main/packages/grader#readme",
    "main": "./dist/index.js",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "import": {
                "types": "./dist/index.d.mts",
                "default": "./dist/index.mjs"
            },
            "require": {
                "types": "./dist/index.d.ts",
                "default": "./dist/index.js"
            }
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist"
    ],
    "publishConfig": {
        "access": "public"
    },
    "dependencies": {
        "@math-blocks/semantic": "workspace:^",
        "@math-blocks/solver": "workspace:^"
    },
    "devDependencies": {
        "@math-blocks/core": "workspace:^",
        "@math-blocks/parser": "workspace:^"
    }
}
