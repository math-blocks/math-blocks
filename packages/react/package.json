{
    "name": "@math-blocks/react",
    "version": "0.0.16",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/math-blocks/math-blocks.git",
        "directory": "packages/react"
    },
    "bugs": "https://github.com/math-blocks/math-blocks/issues",
    "homepage": "https://github.com/math-blocks/math-blocks/tree/main/packages/react#readme",
    "main": "./dist/index.js",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "import": {
                "types": "./dist/index.d.mts",
                "default": "./dist/index.mjs"
            },
            "require": {
                "types": "./dist/index.d.ts",
                "default": "./dist/index.js"
            }
        },
        "./index.css": "./dist/index.css",
        "./package.json": "./package.json"
    },
    "files": [
        "dist"
    ],
    "publishConfig": {
        "access": "public"
    },
    "dependencies": {
        "@math-blocks/core": "^0.0.13",
        "@math-blocks/editor": "^0.0.15",
        "@math-blocks/opentype": "^0.0.14",
        "@math-blocks/semantic": "^0.1.2",
        "@math-blocks/tex": "^0.1.2",
        "@math-blocks/typesetter": "^0.0.15",
        "classnames": "^2.3.1"
    },
    "peerDependencies": {
        "react": "^18.0.0"
    }
}
